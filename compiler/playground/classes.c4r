class Apple {
    int mutable amount = 0;
public:
    void fall() {
        if (amount > 0) {
            "ouch!\n";
            amount--;
        }
        else {
            "no apple lol\n";
        }
    }

    Apple(int amt) {
        amount = amt;
    }
};

int main() {
    Apple mutable ap = Apple(3);
    ap.fall();
    ap.fall();
    ap.fall();
    ap.fall();
    return 0;
}